NODE_ENV=development
PORT=4000
API_PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/richbake
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_ACCESS_TOKEN=
BUSINESS_NAME=RichBake
BUSINESS_PHONE=
BUSINESS_ADDRESS=
ADMIN_PHONE=
ADMIN_PASSWORD=
# Background jobs run automatically inside the API (node-cron, Africa/Lagos time).
# Set SCHEDULER_ENABLED=false on extra instances if you run more than one (jobs are idempotent either way).
SCHEDULER_ENABLED=true
DAILY_SUMMARY_CRON=0 21 * * *
LOW_STOCK_CRON=0 7-20 * * *
# Optional: enables manual/external triggers at /api/v1/internal/jobs/* via the x-cron-secret header.
# Leave empty to keep those endpoints closed. Use a long random value if you set it.
CRON_SECRET=
# Number of reverse-proxy hops in front of the API (1 on most hosting platforms). Leave empty when
# the API is reached directly. Required for per-client login rate limiting behind a proxy.
TRUST_PROXY=
# trace | debug | info | warn | error
LOG_LEVEL=info
